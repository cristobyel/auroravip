{%- comment -%}
  ============================================================
  COLLECTION MOSAIC — mosaico de colecoes recomendadas
  ============================================================

  O QUE FAZ:
  Titulo + subtitulo e um mosaico de ate 3 colecoes: o primeiro bloco e um
  card grande (ocupa 2 linhas) e os demais ficam empilhados ao lado. Cada
  card tem imagem, titulo serifado e botao "Ver tudo". Estilo da secao
  "Most Recommend Collections For You" do layout de referencia.

  ONDE E USADA:
  templates/index.json (meio/fim da home).

  PRINCIPAIS PARTES:
  - Blocks "tile": collection, image, heading, button_label, link.
  - Imagem: do bloco, senao a imagem de destaque da colecao, senao placeholder
    dourado/preto. Titulo e link caem para os da colecao quando vazios.
  - Botao e "stretched link": o card inteiro e clicavel.
  - Mobile: cards empilhados em coluna unica.

  OBSERVACOES:
  Com 1 ou 2 blocos o layout se ajusta sozinho (sem buracos no grid).
{%- endcomment -%}
<div class="mosaic page-width" data-section-id="{{ section.id }}">
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="section-heading">
      {%- if section.settings.heading != blank -%}
        <h2 class="section-heading__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="section-heading__text">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <ul class="mosaic__grid mosaic__grid--{{ section.blocks.size }}" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign col = collections[block.settings.collection]
        assign tile_image = block.settings.image | default: col.featured_image
        assign tile_link = block.settings.link | default: col.url | default: '#'
        assign tile_heading = block.settings.heading | default: col.title
      -%}
      <li class="mosaic-tile" {{ block.shopify_attributes }}>
        <div class="mosaic-tile__media">
          {%- if tile_image != blank -%}
            {{
              tile_image
              | image_url: width: 1100
              | image_tag:
                loading: 'lazy',
                class: 'mosaic-tile__image',
                widths: '550, 825, 1100',
                sizes: '(min-width: 1000px) 50vw, 100vw',
                alt: tile_heading
            }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'mosaic-tile__image mosaic-tile__placeholder' }}
          {%- endif -%}
        </div>
        <div class="mosaic-tile__body">
          {%- if tile_heading != blank -%}
            <h3 class="mosaic-tile__heading">{{ tile_heading | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a href="{{ tile_link }}" class="mosaic-tile__button button button--small button--soft">{{ block.settings.button_label | escape }}</a>
          {%- else -%}
            <a href="{{ tile_link }}" class="mosaic-tile__button" aria-label="{{ tile_heading | escape }}"></a>
          {%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ul>
</div>

<style>
  .mosaic { padding-top: var(--spacing-sections); }
  .mosaic__grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 20px;
    height: clamp(480px, 46vw, 640px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mosaic__grid--1 { grid-template-columns: 1fr; grid-template-rows: 1fr; }
  .mosaic__grid--2 { grid-template-rows: 1fr; }
  .mosaic__grid--3 .mosaic-tile:first-child { grid-row: span 2; }

  .mosaic-tile {
    position: relative;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border-radius: var(--media-radius);
    background: linear-gradient(160deg, #2a2113 0%, var(--color-ink) 70%);
    isolation: isolate;
  }
  .mosaic-tile__media { position: absolute; inset: 0; }
  .mosaic-tile__image { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .mosaic-tile__placeholder { opacity: 0.18; padding: 14%; color: var(--color-gold); fill: currentColor; }
  .mosaic-tile:hover .mosaic-tile__image:not(.mosaic-tile__placeholder) { transform: scale(1.04); }
  .mosaic-tile::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(0deg, rgba(11, 11, 11, 0.72) 0%, rgba(11, 11, 11, 0.12) 50%, rgba(11, 11, 11, 0) 75%);
    pointer-events: none;
  }
  /* Corpo e flex item (z-index sem position) para o botao esticar sobre o card inteiro */
  .mosaic-tile__body {
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 26px;
  }
  .mosaic-tile__heading { margin: 0; font-size: clamp(1.4rem, 2.4vw, 2rem); line-height: 1.15; color: var(--color-cream-text); }
  .mosaic-tile__button::after { content: ''; position: absolute; inset: 0; z-index: 3; }
  .mosaic-tile__button:not(.button) { position: static; }

  @media screen and (max-width: 749px) {
    .mosaic__grid,
    .mosaic__grid--1,
    .mosaic__grid--2 { grid-template-columns: 1fr; grid-template-rows: none; height: auto; gap: 14px; }
    .mosaic__grid--3 .mosaic-tile:first-child { grid-row: auto; }
    .mosaic-tile { aspect-ratio: 4 / 3; }
    .mosaic__grid .mosaic-tile:first-child { aspect-ratio: 4 / 5; }
    .mosaic-tile__body { padding: 20px; }
  }
</style>

{% schema %}
{
  "name": "Mosaico de coleções",
  "tag": "section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Coleções recomendadas para você" },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Correntes, pingentes e acessórios para compor o seu estilo com a exclusividade do ouro 18k." }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Coleção",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Coleção", "info": "Usada para o link e, se não houver imagem abaixo, para a imagem do card." },
        { "type": "image_picker", "id": "image", "label": "Imagem (opcional)", "info": "O primeiro card é grande (ideal 1100 x 1300 px); os demais são paisagem (ideal 1100 x 640 px)." },
        { "type": "text", "id": "heading", "label": "Título", "info": "Se vazio, usa o nome da coleção." },
        { "type": "text", "id": "button_label", "label": "Texto do botão", "default": "Ver tudo" },
        { "type": "url", "id": "link", "label": "Link", "info": "Se vazio, usa o link da coleção." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mosaico de coleções",
      "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }]
    }
  ]
}
{% endschema %}
