{%- comment -%}
  ============================================================
  PROMO CARDS — cards promocionais arredondados com imagem
  ============================================================

  O QUE FAZ:
  Fileira de cards altos (3:4) com imagem de fundo, degradê escuro, texto e
  botao. Cada card e um bloco e pode apontar para uma colecao ou um link
  qualquer. Estilo dos 3 cards logo abaixo do hero no layout de referencia.

  ONDE E USADA:
  templates/index.json (logo apos o hero).

  PRINCIPAIS PARTES:
  - Blocks "card": collection, image, heading, text, button_label, link,
    text_align (esquerda embaixo / centro).
  - Imagem: usa a imagem do bloco; se vazia, a imagem de destaque da colecao;
    se tambem vazia, um placeholder com fundo dourado/preto.
  - Titulo e link caem para o titulo/URL da colecao quando nao preenchidos.
  - O botao e um "stretched link": o card inteiro e clicavel.
  - Mobile: vira carrossel horizontal com scroll-snap.

  OBSERVACOES:
  O numero de colunas acompanha a quantidade de cards (maximo 4).
{%- endcomment -%}
<div class="promo-cards page-width" data-section-id="{{ section.id }}" style="--cols: {{ section.blocks.size | at_least: 1 }};">
  <ul class="promo-cards__grid" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign col = collections[block.settings.collection]
        assign card_image = block.settings.image | default: col.featured_image
        assign card_link = block.settings.link | default: col.url | default: '#'
        assign card_heading = block.settings.heading | default: col.title
      -%}
      <li class="promo-card promo-card--{{ block.settings.text_align }}" {{ block.shopify_attributes }}>
        <div class="promo-card__media">
          {%- if card_image != blank -%}
            {{
              card_image
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                class: 'promo-card__image',
                widths: '450, 675, 900',
                sizes: '(min-width: 1000px) 33vw, 80vw',
                alt: card_heading
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'promo-card__image promo-card__placeholder' }}
          {%- endif -%}
        </div>
        <div class="promo-card__body">
          {%- if card_heading != blank -%}
            <h3 class="promo-card__heading">{{ card_heading | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="promo-card__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a href="{{ card_link }}" class="promo-card__button button button--small {% if block.settings.text_align == 'center' %}button--soft{% else %}button--ink{% endif %}">{{ block.settings.button_label | escape }}</a>
          {%- else -%}
            <a href="{{ card_link }}" class="promo-card__button promo-card__button--bare" aria-label="{{ card_heading | escape }}"></a>
          {%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ul>
</div>

<style>
  .promo-cards { padding-top: var(--spacing-sections); }
  .promo-cards__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .promo-card {
    position: relative;
    display: flex;
    align-items: flex-end;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: var(--media-radius);
    background: linear-gradient(160deg, #2a2113 0%, var(--color-ink) 70%);
    isolation: isolate;
  }
  .promo-card__media { position: absolute; inset: 0; }
  .promo-card__image { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .promo-card__placeholder { opacity: 0.18; padding: 18%; color: var(--color-gold); fill: currentColor; }
  .promo-card:hover .promo-card__image:not(.promo-card__placeholder) { transform: scale(1.05); }
  .promo-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(0deg, rgba(11, 11, 11, 0.82) 0%, rgba(11, 11, 11, 0.25) 45%, rgba(11, 11, 11, 0) 70%);
    pointer-events: none;
  }
  /* Corpo e flex item (z-index sem position) para o botao esticar sobre o card inteiro */
  .promo-card__body {
    z-index: 2;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 24px;
    color: var(--color-cream-text);
  }
  .promo-card__heading { margin: 0; font-size: clamp(1.15rem, 1.8vw, 1.5rem); line-height: 1.2; color: var(--color-cream-text); }
  .promo-card__text { margin: 0; font-size: var(--f1); line-height: 1.45; color: rgba(244, 236, 216, 0.85); }
  .promo-card__button { margin-top: 6px; }
  .promo-card__button::after { content: ''; position: absolute; inset: 0; z-index: 3; }
  .promo-card__button--bare { position: static; }

  /* Variante centralizada (estilo "STYLE-STACK" do layout de referencia) */
  .promo-card--center { align-items: center; }
  .promo-card--center::after { background: linear-gradient(0deg, rgba(11, 11, 11, 0.55) 0%, rgba(11, 11, 11, 0.3) 100%); }
  .promo-card--center .promo-card__body { align-items: center; justify-content: center; text-align: center; }
  .promo-card--center .promo-card__heading { font-size: clamp(1.5rem, 2.6vw, 2.1rem); letter-spacing: 0.04em; text-transform: uppercase; }

  @media screen and (max-width: 999px) {
    .promo-cards__grid {
      display: flex;
      overflow-x: auto;
      gap: 14px;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding-bottom: 4px;
    }
    .promo-cards__grid::-webkit-scrollbar { display: none; }
    .promo-card { flex: 0 0 78%; max-width: 360px; scroll-snap-align: start; }
  }
</style>

{% schema %}
{
  "name": "Cards promocionais",
  "tag": "section",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Coleção", "info": "Usada para o link e, se não houver imagem abaixo, para a imagem do card." },
        { "type": "image_picker", "id": "image", "label": "Imagem (opcional)", "info": "Recomendado: 900 x 1200 px (3:4)." },
        { "type": "text", "id": "heading", "label": "Título", "info": "Se vazio, usa o nome da coleção." },
        { "type": "textarea", "id": "text", "label": "Texto" },
        { "type": "text", "id": "button_label", "label": "Texto do botão" },
        { "type": "url", "id": "link", "label": "Link", "info": "Se vazio, usa o link da coleção." },
        {
          "type": "select",
          "id": "text_align",
          "label": "Posição do texto",
          "options": [
            { "value": "left", "label": "Embaixo, à esquerda" },
            { "value": "center", "label": "Centralizado" }
          ],
          "default": "left"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cards promocionais",
      "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card", "settings": { "text_align": "center" } }]
    }
  ]
}
{% endschema %}
