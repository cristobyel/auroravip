{%- comment -%}
  ============================================================
  HERO SLIDER — banner principal da home com slides
  ============================================================

  O QUE FAZ:
  Banner de destaque em container arredondado (estilo "vitrine"), com um ou
  mais slides. Cada slide e um bloco com imagem, link e, opcionalmente, texto
  e botao sobrepostos. Setas e pontos de navegacao ficam no canto inferior
  direito. Funciona por scroll-snap (arraste no mobile) e tem autoplay.

  ONDE E USADA:
  templates/index.json (topo da home).

  PRINCIPAIS PARTES:
  - Blocks "slide": image, mobile_image, mobile_focus, alt, link, heading,
    text, button_label.
  - Sem imagem escolhida no editor, o slide usa assets/aurora-banner.webp.
  - Se o slide NAO tem texto sobreposto, ele inteiro vira um link (o banner
    da Aurora VIP ja traz o texto e o botao desenhados na propria imagem).
  - Mobile: por padrao recorta a imagem em 4:5 com foco na esquerda, para o
    texto do banner nao ficar minusculo. Use mobile_focus = "full" para
    mostrar a imagem inteira, ou envie uma mobile_image propria.

  OBSERVACOES:
  Autoplay pausa no hover/foco/toque e e desligado com prefers-reduced-motion.
  Um <h1> visualmente oculto (seo_heading) garante o titulo da pagina para SEO.
{%- endcomment -%}
{%- liquid
  assign slide_count = section.blocks.size
-%}
<div
  class="hero page-width"
  data-hero
  data-section-id="{{ section.id }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  {% if slide_count > 1 %}role="region" aria-roledescription="carousel" aria-label="{{ section.settings.seo_heading | escape }}"{% endif %}>
  {%- if section.settings.seo_heading != blank -%}
    <h1 class="visually-hidden">{{ section.settings.seo_heading | escape }}</h1>
  {%- endif -%}

  <div class="hero__frame">
    <div class="hero__track" data-track>
      {%- for block in section.blocks -%}
        {%- liquid
          assign image = block.settings.image
          assign mobile_image = block.settings.mobile_image
          assign desktop_ratio = image.aspect_ratio | default: 1.79
          assign mobile_ratio = 0.8
          if mobile_image != blank
            assign mobile_ratio = mobile_image.aspect_ratio
          elsif block.settings.mobile_focus == 'full'
            assign mobile_ratio = desktop_ratio
          endif

          assign has_overlay = false
          if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank
            assign has_overlay = true
          endif

          assign img_loading = 'lazy'
          assign img_priority = 'low'
          if forloop.first
            assign img_loading = 'eager'
            assign img_priority = 'high'
          endif
          assign img_alt = block.settings.alt | default: block.settings.heading | default: shop.name
        -%}
        <div
          class="hero__slide{% if has_overlay %} hero__slide--overlay{% endif %}"
          id="Slide-{{ section.id }}-{{ forloop.index }}"
          {% if slide_count > 1 %}role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ slide_count }}"{% endif %}
          {{ block.shopify_attributes }}>
          <div
            class="hero__media hero__media--{{ block.settings.mobile_focus }}"
            style="--hero-ratio: {{ desktop_ratio }}; --hero-ratio-mobile: {{ mobile_ratio }};">
            <picture>
              {%- if mobile_image != blank -%}
                <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1100 }} 1100w" sizes="100vw">
              {%- endif -%}
              {%- if image != blank -%}
                {{
                  image
                  | image_url: width: 2000
                  | image_tag:
                    loading: img_loading,
                    fetchpriority: img_priority,
                    class: 'hero__image',
                    widths: '750, 1100, 1500, 2000',
                    sizes: '(min-width: 1320px) 1280px, 100vw',
                    alt: img_alt
                }}
              {%- else -%}
                <img
                  class="hero__image"
                  src="{{ 'aurora-banner.webp' | asset_url }}"
                  width="1024"
                  height="572"
                  loading="{{ img_loading }}"
                  fetchpriority="{{ img_priority }}"
                  alt="{{ img_alt | escape }}">
              {%- endif -%}
            </picture>
          </div>

          {%- if has_overlay -%}
            <div class="hero__content">
              <div class="hero__box">
                {%- if block.settings.heading != blank -%}
                  <h2 class="hero__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="hero__text">{{ block.settings.text | escape }}</p>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="button button--gold">{{ block.settings.button_label | escape }}</a>
                {%- endif -%}
              </div>
            </div>
          {%- elsif block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="hero__link" aria-label="{{ img_alt | escape }}"></a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if slide_count > 1 -%}
      <div class="hero__controls">
        {%- if section.settings.show_dots -%}
          <div class="hero__dots">
            {%- for block in section.blocks -%}
              <button type="button" class="hero__dot" data-dot aria-label="{{ forloop.index }} / {{ slide_count }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
        <button type="button" class="hero__arrow" data-prev aria-label="Slide anterior">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false"><path d="m11 3-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="hero__arrow" data-next aria-label="Próximo slide">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false"><path d="m7 3 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .hero { padding-top: 20px; }
  .hero__frame {
    position: relative;
    overflow: hidden;
    border-radius: calc(var(--media-radius) + 4px);
    background-color: var(--color-ink);
    box-shadow: 0 18px 40px rgba(11, 11, 11, 0.22);
  }
  .hero__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .hero__track::-webkit-scrollbar { display: none; }
  .hero__slide { position: relative; flex: 0 0 100%; scroll-snap-align: start; }
  .hero__media { position: relative; width: 100%; aspect-ratio: var(--hero-ratio); background-color: var(--color-ink); }
  .hero__media picture { display: contents; }
  .hero__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero__link { position: absolute; inset: 0; z-index: 2; }

  /* Texto sobreposto (opcional) */
  .hero__slide--overlay .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(11, 11, 11, 0.78) 0%, rgba(11, 11, 11, 0.35) 55%, rgba(11, 11, 11, 0) 100%);
  }
  .hero__content { position: absolute; inset: 0; z-index: 2; display: flex; align-items: center; padding: 0 clamp(24px, 6vw, 80px); }
  .hero__box { max-width: 520px; }
  .hero__heading { margin: 0 0 14px; font-size: clamp(2rem, 4.6vw, 3.6rem); line-height: 1.08; color: var(--color-cream-text); }
  .hero__text { margin: 0 0 24px; font-size: var(--f3); line-height: 1.5; color: rgba(244, 236, 216, 0.85); }

  /* Setas e pontos */
  .hero__controls {
    position: absolute;
    right: 18px;
    bottom: 18px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .hero__dots { display: flex; gap: 6px; margin-right: 6px; padding: 8px 10px; border-radius: 999px; background: rgba(11, 11, 11, 0.55); }
  .hero__dot { width: 8px; height: 8px; padding: 0; border: 0; border-radius: 50%; background: rgba(244, 236, 216, 0.4); cursor: pointer; transition: width 0.25s ease, background 0.25s ease; }
  .hero__dot[aria-current='true'] { width: 22px; border-radius: 999px; background: var(--gradient-gold); }
  .hero__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    color: var(--color-gold-light);
    background-color: rgba(11, 11, 11, 0.85);
    border: 1px solid var(--color-gold-dark);
    border-radius: 50%;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .hero__arrow:hover { color: var(--color-ink); background: var(--gradient-gold); }

  @media screen and (max-width: 749px) {
    .hero { padding-top: 12px; }
    .hero__media { aspect-ratio: var(--hero-ratio-mobile); }
    .hero__media--left .hero__image { object-position: 4% center; }
    .hero__media--center .hero__image { object-position: 50% center; }
    .hero__media--right .hero__image { object-position: 96% center; }
    .hero__slide--overlay .hero__media::after { background: linear-gradient(0deg, rgba(11, 11, 11, 0.85) 0%, rgba(11, 11, 11, 0.2) 70%); }
    .hero__content { align-items: flex-end; padding-bottom: 64px; }
    .hero__arrow { width: 38px; height: 38px; }
    .hero__controls { right: 12px; bottom: 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__track { scroll-behavior: auto; }
  }
</style>

<script>
  (function () {
    var root = document.querySelector('[data-hero][data-section-id="{{ section.id }}"]');
    if (!root) return;
    var track = root.querySelector('[data-track]');
    var slides = track.querySelectorAll('.hero__slide');
    if (slides.length < 2) return;

    var dots = root.querySelectorAll('[data-dot]');
    var prev = root.querySelector('[data-prev]');
    var next = root.querySelector('[data-next]');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var speed = parseInt(root.getAttribute('data-speed'), 10) || 6000;
    var index = 0;
    var timer = null;

    function go(i) {
      index = (i + slides.length) % slides.length;
      track.scrollTo({ left: index * track.clientWidth, behavior: reduce ? 'auto' : 'smooth' });
    }

    function sync() {
      index = Math.round(track.scrollLeft / (track.clientWidth || 1));
      dots.forEach(function (dot, n) {
        dot.setAttribute('aria-current', n === index ? 'true' : 'false');
      });
    }

    function stop() {
      if (timer) { clearInterval(timer); timer = null; }
    }

    function start() {
      if (root.getAttribute('data-autoplay') !== 'true' || reduce) return;
      stop();
      timer = setInterval(function () {
        if (!document.body.contains(root)) { stop(); return; }
        go(index + 1);
      }, speed);
    }

    track.addEventListener('scroll', function () { window.requestAnimationFrame(sync); }, { passive: true });
    if (prev) prev.addEventListener('click', function () { go(index - 1); });
    if (next) next.addEventListener('click', function () { go(index + 1); });
    dots.forEach(function (dot, n) { dot.addEventListener('click', function () { go(n); }); });

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    root.addEventListener('touchstart', stop, { passive: true });
    document.addEventListener('visibilitychange', function () { document.hidden ? stop() : start(); });
    window.addEventListener('resize', function () { track.scrollTo({ left: index * track.clientWidth, behavior: 'auto' }); });

    start();
  })();
</script>

{% schema %}
{
  "name": "Hero slider",
  "tag": "section",
  "class": "section-hero",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "seo_heading", "label": "Título da página (oculto, para SEO)", "default": "Aurora VIP | Joias exclusivas banhadas a ouro 18k" },
    { "type": "checkbox", "id": "autoplay", "label": "Troca automática de slides", "default": true },
    { "type": "range", "id": "autoplay_speed", "min": 3, "max": 10, "step": 1, "unit": "s", "label": "Tempo entre slides", "default": 6 },
    { "type": "checkbox", "id": "show_dots", "label": "Mostrar indicadores (pontos)", "default": true }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem (desktop)", "info": "Se vazio, usa assets/aurora-banner.webp. Recomendado: 2400 x 1340 px." },
        { "type": "image_picker", "id": "mobile_image", "label": "Imagem (mobile, opcional)", "info": "Recomendado: 1000 x 1250 px (4:5)." },
        {
          "type": "select",
          "id": "mobile_focus",
          "label": "Mobile: enquadramento da imagem",
          "info": "Vale quando não há imagem mobile separada.",
          "options": [
            { "value": "left", "label": "Recortar, foco à esquerda" },
            { "value": "center", "label": "Recortar, foco ao centro" },
            { "value": "right", "label": "Recortar, foco à direita" },
            { "value": "full", "label": "Mostrar imagem inteira" }
          ],
          "default": "left"
        },
        { "type": "text", "id": "alt", "label": "Texto alternativo (acessibilidade)", "default": "Joias exclusivas banhadas a ouro 18k — Conheça a coleção" },
        { "type": "url", "id": "link", "label": "Link do slide" },
        { "type": "header", "content": "Texto sobreposto (opcional)" },
        { "type": "text", "id": "heading", "label": "Título", "info": "Deixe vazio se a imagem já tem texto." },
        { "type": "textarea", "id": "text", "label": "Texto" },
        { "type": "text", "id": "button_label", "label": "Texto do botão" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slider",
      "blocks": [{ "type": "slide" }]
    }
  ]
}
{% endschema %}
